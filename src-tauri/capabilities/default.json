{
  "$schema": "https://schema.tauri.app/schema/capability",
  "identifier": "default",
  "description": "Default Yara Kiosk permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:read-all",
    "fs:write-all",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-exists"
  ]
}
